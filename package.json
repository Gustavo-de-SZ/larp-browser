{
  "name": "larp-browser",
  "version": "1.2.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build.js",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "cross-env NODE_ENV=production electron dist/main/index.cjs --in-process-gpu",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron dist/main/index.cjs --in-process-gpu",
    "dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev:renderer\" \"npm run build:main && npm run dev:electron\"",
    "dist": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --linux --dir",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:pacman": "npm run build && electron-builder --linux pacman"
  },
  "keywords": [
    "browser",
    "electron",
    "tabs",
    "alt-tab",
    "larp"
  ],
  "author": "Larp Browser Team <dev@larpbrowser.org>",
  "license": "MIT",
  "description": "Larp Browser - Modern desktop browser with Alt-Tab visual tab switching and vibrant themes",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "build": {
    "appId": "com.larp.browser",
    "productName": "Larp Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "maintainer": "Larp Browser Team <dev@larpbrowser.org>",
      "category": "Network",
      "executableArgs": [
        "--in-process-gpu"
      ],
      "synopsis": "Fast, keyboard-driven web browser",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "larp-browser"
        }
      }
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxss"
      ]
    }
  },
  "desktopName": "larp-browser"
}
